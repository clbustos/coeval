- # assessment
- # field
- if @datetime_js.nil?
  - @datetime_js=true
  %script{:type=>'text/javascript', :src=>url('/js/datetime_input.js')}
%label.control-label.col-sm-2="#{t(field)}:"
- datetime_loc=assessment[field].nil? ? DateTime.now : assessment[field]
- class_date=assessment[field].nil? ? "collapse":""
.col-sm-3
  .checkbox
    %label
      %input{type:'checkbox', class:'checkbox_to_datetime', name:"#{field}_nil", id:"#{field}_nil", checked:assessment[field].nil?, "data-datetime-field"=>field.to_s}
      =t(:Set_no_datetime)
.col-sm-5
  %input{type:'datetime-local', class:"form-control assessment-datetime #{class_date}", name:field.to_s, id:field.to_s, value: datetime_loc.strftime("%Y-%m-%dT%H:%M")}
