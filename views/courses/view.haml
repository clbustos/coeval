.heading=t_course_title(@course[:name],:View)
%ul.breadcrumb
  %li
    %a{:href=>url("/courses")}=t(:Courses)
  %li.active=@course[:name]
%h3=t(:General_information)
%div.list-group
  %div{:class=>"list-group-item"}
    %span{:class=>"titulo"}=t(:Id)
    %span{ :name=>"name"}=@course[:id]
  %div{:class=>"list-group-item"}
    %span{:class=>"titulo"}=t(:Name)
    %span{ :name=>"name"}=@course[:name]
  %div{:class=>"list-group-item"}
    %span{:class=>"titulo"}=t(:Description)
    =@course[:description]
  %div{:class=>"list-group-item"}
    %span{:class=>"titulo"}=t(:Active)
    =t_yes_no_nil(@course[:active])
  %div{:class=>"list-group-item"}
    %span{:class=>"titulo"}=t(:Institution)
    %span=@course.institution_name
  %div{:class=>"list-group-item"}
    %span{:class=>"titulo"}=t(:Lead_teacher)
    %span=@course.teacher_name
  %div{:class=>"list-group-item"}
    %span{:class=>"titulo"}=t(:Assistant_teachers)
    %div
      %ul
        - @current_assistant_teachers.each do |assistant_teacher|
          %li=assistant_teacher[:name]



%h3=t(:Assessments)
- if @assessment_management_access
  .btn-group.btn-group-sm
    %a.btn.btn-default{:href=>url("/course/#{@course[:id]}/assessment/new")}
      %span.glyphicon.glyphicon-plus
      =t(:New_assessment)
    %a.btn.btn-default{:href=>url("/course/#{@course[:id]}/excel")}
      %span.glyphicon.glyphicon-transfer
      =t(:Course_excel_import_export)
- if @course.assessments.count>0
  %ul
    - @course.assessments.each do |assessment|
      %li
        %a{:href=>url("/assessment/#{assessment[:id]}")}=assessment[:name]
  - if @assessment_management_access
    .btn-group.btn-group-sm
      %a.btn.btn-default{:href=>url("/course/#{@course[:id]}/response_detail")}
        =t(:Response_detail)

- else
  %p
    %em=t(:No_assessments)

- if auth_to("course_view")
  - unless @assistant_course_access && !@assistant_course_monitor
    %h3=t(:Students)
    %p=t(:Student_number, number:@students.count)
    %ul.list_group
      -@students.each do |student|
        %li=student[:name]
  %h3=t(:Students_groups)
  - if @course_assessments.any?
    - @course_assessments.each do |assessment|
      .panel.panel-default
        .panel-heading
          %h4.panel-title
            %a{:href=>url("/assessment/#{assessment[:id]}")}=assessment[:name]
        .panel-body
          - teams=@teams_by_assessment[assessment[:id]]
          - if teams.any?
            - teams.each do |team_data|
              %section
                %h5
                  - if @assistant_course_access
                    =team_data[:team][:name]
                  - else
                    %a{:href=>url("/team/#{team_data[:team][:id]}")}=team_data[:team][:name]
                %p
                  %strong="#{t(:Teacher)}:"
                  =team_data[:teacher][:name]
                %p
                  %strong="#{t(:Members)}:"
                - if team_data[:members].any?
                  %ul
                    - team_data[:members].each do |student|
                      %li
                        - if @assistant_course_access
                          =student[:name]
                        - else
                          %a{:href=>url("/team/#{team_data[:team][:id]}/student/#{student[:id]}")}=student[:name]
                - else
                  %p
                    %em=t(:No_team_members)
          - else
            %p
              %em=t(:No_teams)
  - else
    %p
      %em=t(:No_assessments)

- if @course_management_access
  %h4=t(:Add_student_to_course)
  %form.form-inline{method:'get', action:url("/course/#{@course[:id]}")}
    .form-group
      %label=t(:Search_by_name)
      %input.form-control{type:'text', name:'student_search', value:@student_search}
    %button.btn.btn-default{type:'submit'}=t(:Search)
  - if @student_search and @student_search.length>0
    - if @student_search_results.count>0
      %table.table
        %thead
          %tr
            %th=t(:Student)
            %th=t(:Email)
            %th=t(:Actions)
        %tbody
          - @student_search_results.each do |student|
            %tr
              %td=student[:name]
              %td=student[:email]
              %td
                %form{method:'post', action:url("/course/#{@course[:id]}/student_courses")}
                  %input{type:'hidden', name:'user_id', value:student[:id]}
                  %button.btn.btn-sm.btn-primary{type:'submit'}=t(:Add)
    - else
      %p
        %em=t(:No_students_found)

  %div{:class=>"list-group-item"}
    %h4{:class=>"list-group-item-heading"}=t(:Actions)
    %p=partial(:course_buttons, :locals=>{:course=>@course})
