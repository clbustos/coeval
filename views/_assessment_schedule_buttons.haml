- if can_manage_assessment_schedule?(assessment)
  .btn-group.btn-group-sm{role:'group', 'aria-label'=>t(:Assessment_schedule_actions)}
    - {open_evaluation: :Open_evaluation, open_feedback: :Open_feedback, close_feedback: :Close_feedback}.each do |action, label|
      %form{method:'post', action:url("/assessment/#{assessment[:id]}/schedule/#{action}"), style:'display:inline-block'}
        %button.btn{type:'submit', class:action == :close_feedback ? 'btn-warning' : 'btn-default'}=t(label)
